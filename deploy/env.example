# Copy to deploy/.env on the server (never commit .env). Values here are placeholders.
# The public host name; its DNS A record points at this server.
DOMAIN=lab.example.org
# Long random string for signing teacher cookies, e.g.:  python3 -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=
# Optional: Claude for the mentor's phrasing. Without it the mentor uses approved texts only.
ANTHROPIC_API_KEY=
# Optional: POST a JSON alert here on server errors (Slack/Teams incoming webhook, error collector).
ERROR_WEBHOOK_URL=
# Lessons close by themselves after this many hours.
LESSON_HOURS=4
# Nightly backups kept.
BACKUP_KEEP=14
APP_VERSION=dev
